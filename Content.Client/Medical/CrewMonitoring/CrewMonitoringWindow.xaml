<!-- Lua start -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:ui="clr-namespace:Content.Client.Medical.CrewMonitoring"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'crew-monitoring-user-interface-title'}"
                      Resizable="False"
                      SetSize="1200 720">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Margin="5">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BorderColor="#444444" BorderThickness="2"/>
                </PanelContainer.PanelOverride>
                <ui:CrewMonitoringNavMapControl Name="NavMap"/>
            </PanelContainer>
            <BoxContainer Orientation="Vertical" Margin="0 0 6 0">
                <controls:StripeBack>
                    <PanelContainer>
                        <Label Name="StationName" Align="Center" StyleClasses="LabelBig" Margin="2"/>
                    </PanelContainer>
                </controls:StripeBack>
                <BoxContainer Orientation="Horizontal">
                    <LineEdit Name="SearchLineEdit"
                              HorizontalExpand="True"
                              PlaceHolder="{Loc 'crew-monitor-filter-line-placeholder'}"/>
                    <Button Name="AliveFilterButton"
                            Text="{Loc 'crew-monitoring-filter-alive'}"
                            ToggleMode="True"/>
                    <Button Name="CriticalFilterButton"
                            Text="{Loc 'crew-monitoring-filter-critical'}"
                            ToggleMode="True"/>
                    <Button Name="DeadFilterButton"
                            Text="{Loc 'crew-monitoring-filter-dead'}"
                            ToggleMode="True"/>
                </BoxContainer>
                <PanelContainer HorizontalExpand="True" VerticalExpand="True" Margin="0 3 3 5">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BorderColor="#444444" BorderThickness="2"/>
                    </PanelContainer.PanelOverride>
                    <ScrollContainer Name="SensorScroller"
                                     HScrollEnabled="False"
                                     VerticalExpand="True"
                                     MinWidth="524">
                        <BoxContainer Name="SensorsTable" Orientation="Vertical"/>
                        <Label Name="NoServerLabel"
                               Text="{Loc 'crew-monitoring-user-interface-no-server'}"
                               StyleClasses="LabelHeading"
                               FontColorOverride="Red"
                               HorizontalAlignment="Center"
                               Visible="False"/>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider"/>
            <BoxContainer Orientation="Horizontal" Margin="10 2 5 0" VerticalAlignment="Bottom">
                <Label Text="{Loc 'crew-monitoring-user-interface-flavor-left'}"
                       StyleClasses="WindowFooterText"
                       HorizontalAlignment="Left"
                       Margin="0 0 5 0" />
                <Label Text="{Loc 'crew-monitoring-user-interface-flavor-right'}"
                       StyleClasses="WindowFooterText"
                       HorizontalAlignment="Right"
                       HorizontalExpand="True"
                       Margin="0 0 5 0" />
                <TextureRect StyleClasses="NTLogoDark"
                             Stretch="KeepAspectCentered"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Right"
                             SetSize="19 19"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
<!-- Lua end -->
