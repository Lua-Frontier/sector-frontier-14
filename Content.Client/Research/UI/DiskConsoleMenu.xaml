<controls:FancyWindow xmlns="https://spacestation14.io"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                     Title="{Loc 'tech-disk-ui-name'}"
                     MinSize="400 360"
                     SetSize="400 420">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="10 10 10 10">
        <Button Name="ServerButton"
                Text="{Loc 'lathe-menu-server-list'}"
                HorizontalAlignment="Left"></Button>
        <Label Name="TotalLabel"
               Margin="0 10 0 6"
               HorizontalAlignment="Center"/>
        <Label Name="HintLabel"
               HorizontalAlignment="Center"
               Margin="0 0 0 8"/>
        <PanelContainer VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#000000FF"/>
            </PanelContainer.PanelOverride>
            <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                <BoxContainer Name="OptionsContainer"
                              Orientation="Vertical"
                              SeparationOverride="6"
                              Margin="8"
                              HorizontalExpand="True"/>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
