<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="{Loc 'company-capture-window-progress'}"
               SetSize="560 214"
               MinSize="560 214"
               MaxSize="560 214">
    <PanelContainer Name="CapturePanel"
                    Access="Public"
                    HorizontalExpand="True">
        <BoxContainer Orientation="Vertical"
                      SeparationOverride="10"
                      Margin="10 10 10 10">
            <Label Name="FactionsLabel"
                   HorizontalExpand="True"
                   Align="Center"
                   Access="Public" />
            <BoxContainer Name="DetailsContainer"
                          Orientation="Vertical"
                          SeparationOverride="10"
                          Access="Public">
                <Label Name="PresenceLabel"
                       Align="Center"
                       Access="Public" />
                <Label Name="StatusLabel"
                       Align="Center"
                       Access="Public" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal"
                          SeparationOverride="8"
                          HorizontalExpand="True">
                <ProgressBar Name="CaptureProgressBar"
                             MinValue="0"
                             MaxValue="1"
                             Value="0"
                             HorizontalExpand="True"
                             MinHeight="12"
                                                  VerticalAlignment="Center"
                             Access="Public" />
                            <Label Name="ProgressLabel"
                                      MinWidth="56"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Align="Right"
                                      Access="Public" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
