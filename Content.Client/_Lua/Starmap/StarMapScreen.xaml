<controls:BoxContainer xmlns="https://spacestation14.io"
              xmlns:controls="https://spacestation14.io"
              xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
              xmlns:ftlPoints="clr-namespace:Content.Client._Lua.Starmap"
              xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
              HorizontalExpand="True"
              VerticalExpand="True">
    <controls:PanelContainer HorizontalExpand="True" VerticalExpand="True" Margin="4 2 4 4">
        <controls:PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#0B0F14" BorderColor="#243041" BorderThickness="1" />
        </controls:PanelContainer.PanelOverride>
        <controls:BoxContainer Orientation="Horizontal"
                               Margin="8 8 8 8"
                               SeparationOverride="0"
                               VerticalExpand="True">
            <ftlPoints:StarmapControl Name="StarMapCanvas"
                                      MouseFilter="Stop"
                                      HorizontalExpand="True"
                                      VerticalExpand="True"
                                      VerticalAlignment="Stretch"
                                      RectClipContent="True"/>
            <controls:PanelContainer MinWidth="1" MaxWidth="1" VerticalExpand="True" Margin="0">
                <controls:PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#2A3344" />
                </controls:PanelContainer.PanelOverride>
            </controls:PanelContainer>
            <controls:BoxContainer Name="RightDisplayStarMap"
                                   VerticalAlignment="Stretch"
                                   HorizontalAlignment="Right"
                                   MinWidth="292"
                                   MaxWidth="292"
                                   Margin="0"
                                   Orientation="Vertical"
                                   SeparationOverride="5"
                                   VerticalExpand="True">
                <controls:PanelContainer MinHeight="46" HorizontalExpand="True">
                    <controls:PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#0E1218" BorderColor="#2A3344" BorderThickness="1" />
                    </controls:PanelContainer.PanelOverride>
                    <controls:BoxContainer Orientation="Vertical" Margin="8 5" SeparationOverride="3">
                        <controls:BoxContainer Orientation="Horizontal">
                            <controls:Label Name="WarpStatusHeading"
                                            Text="{controls:Loc 'starmap-warp-status'}"
                                            FontColorOverride="#8A96A8"
                                            HorizontalExpand="True"/>
                            <controls:Label Name="WarpStatusLabel"
                                            Text="{controls:Loc 'shuttle-console-ftl-state-Available'}"
                                            FontColorOverride="#C5CEDB"
                                            HorizontalAlignment="Right"/>
                        </controls:BoxContainer>
                        <ui:ShuttleBssProgressBar Name="FTLBar" HorizontalExpand="True" MinHeight="14"/>
                    </controls:BoxContainer>
                </controls:PanelContainer>
                <controls:PanelContainer HorizontalExpand="True" VerticalExpand="True">
                    <controls:PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#0E1218" BorderColor="#2A3344" BorderThickness="1" />
                    </controls:PanelContainer.PanelOverride>
                    <controls:BoxContainer Orientation="Vertical" Margin="7 6" SeparationOverride="4" VerticalExpand="True">
                        <controls:Label Name="StarMapDisplayLabel"
                                        Text="{controls:Loc 'starmap-ui-title'}"
                                        FontColorOverride="#7E8BA0"
                                        HorizontalAlignment="Left"/>
                        <controls:Label Name="CurrentStarLabel"
                                        Text=""
                                        FontColorOverride="#C5CEDB"
                                        HorizontalAlignment="Left"/>
                        <controls:Label Name="SelectedStarLabel"
                                        Text=""
                                        FontColorOverride="#8A96A8"
                                        HorizontalAlignment="Left"/>
                        <controls:Label Name="LorePanelHeading"
                                        Text="{controls:Loc 'starmap-lore-panel-title'}"
                                        FontColorOverride="#7E8BA0"
                                        HorizontalAlignment="Left"
                                        Margin="0 6 0 0"/>
                        <controls:Label Name="LoreTitleLabel"
                                        Text=""
                                        FontColorOverride="#C5CEDB"
                                        HorizontalAlignment="Left"/>
                        <controls:ScrollContainer Name="LoreSummaryScroll"
                                                  HorizontalExpand="True"
                                                  VerticalExpand="True"
                                                  HScrollEnabled="False"
                                                  VScrollEnabled="True"
                                                  MinHeight="80"
                                                  RectClipContent="True">
                            <controls:Label Name="LoreSummaryLabel"
                                            HorizontalAlignment="Left"
                                            HorizontalExpand="True"/>
                        </controls:ScrollContainer>
                        <controls:Button Name="LoreDetailsButton"
                                         MinHeight="18"
                                         Text="{controls:Loc 'starmap-lore-details'}"
                                         Disabled="True"
                                         HorizontalExpand="True"
                                         TextAlign="Center"/>
                    </controls:BoxContainer>
                </controls:PanelContainer>
                <controls:PanelContainer HorizontalExpand="True">
                    <controls:PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#0E1218" BorderColor="#2A3344" BorderThickness="1" />
                    </controls:PanelContainer.PanelOverride>
                    <controls:BoxContainer Orientation="Vertical" Margin="7 5" SeparationOverride="3">
                        <controls:Button Name="WarpButton"
                                         MinHeight="18"
                                         Text="{controls:Loc 'starmap-star-details-button-warp'}"
                                         Disabled="True"
                                         HorizontalExpand="True"
                                         TextAlign="Center"/>
                    </controls:BoxContainer>
                </controls:PanelContainer>
            </controls:BoxContainer>
        </controls:BoxContainer>
    </controls:PanelContainer>
</controls:BoxContainer>
