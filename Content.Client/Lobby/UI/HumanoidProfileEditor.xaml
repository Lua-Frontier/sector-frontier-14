<BoxContainer xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:humanoid="clr-namespace:Content.Client.Humanoid"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
         VerticalExpand="True"
         SeparationOverride="6">
        <BoxContainer Orientation="Vertical" Margin="6 6 6 6" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">
            <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                    <ui:HighlightedContainer>
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <Label Text="{Loc 'humanoid-profile-editor-name-label'}" MinWidth="44" VerticalAlignment="Center" />
                                <LineEdit Name="NameEdit" MinSize="220 0" HorizontalExpand="True" VerticalAlignment="Center" />
                            </BoxContainer>
                            <RichTextLabel Name="WarningLabel" HorizontalExpand="True" HorizontalAlignment="Left" />
                        </BoxContainer>
                    </ui:HighlightedContainer>

                    <ui:HighlightedContainer>
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                                <Button Name="NameRandomize" Text="{Loc 'humanoid-profile-editor-name-random-button'}" HorizontalExpand="True" />
                                <Button Name="RandomizeEverythingButton" Text="{Loc 'humanoid-profile-editor-randomize-everything-button'}" HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                                <Button Name="SaveButton" Text="{Loc 'humanoid-profile-editor-save-button'}" HorizontalExpand="True" />
                                <Button Name="ResetButton" Disabled="True" Text="{Loc 'humanoid-profile-editor-reset-button'}" HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                                <Button Name="ImportButton" Text="{Loc 'humanoid-profile-editor-import-button'}" HorizontalExpand="True" />
                                <Button Name="ExportButton" Text="{Loc 'humanoid-profile-editor-export-button'}" HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                                <Button Name="ExportImageButton" Text="{Loc 'humanoid-profile-editor-export-image-button'}" HorizontalExpand="True" />
                                <Button Name="OpenImagesButton" Text="{Loc 'humanoid-profile-editor-open-image-button'}" HorizontalExpand="True" />
                            </BoxContainer>
                            <Button Name="CompanyLeaveButton" StyleClasses="Caution" Text="{Loc 'humanoid-profile-editor-company-leave-button'}" HorizontalAlignment="Left" MinWidth="156" />
                            <RichTextLabel Name="CompanyLeaveInfoLabel" HorizontalExpand="True" HorizontalAlignment="Left" />
                        </BoxContainer>
                    </ui:HighlightedContainer>
                </BoxContainer>

                <ui:HighlightedContainer MinSize="136 0">
                    <BoxContainer Orientation="Vertical" SeparationOverride="4" VerticalExpand="True" HorizontalAlignment="Center">
                        <SpriteView Name="SpriteView" Scale="5 5" HorizontalAlignment="Center" SizeFlagsStretchRatio="1" />
                        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="0">
                            <Button Name="SpriteRotateLeft" Text="◀" StyleClasses="OpenRight" />
                            <cc:VSeparator Margin="2 0 3 0" />
                            <Button Name="SpriteRotateRight" Text="▶" StyleClasses="OpenLeft" />
                        </BoxContainer>
                    </BoxContainer>
                </ui:HighlightedContainer>
            </BoxContainer>

            <!-- tabContainer -->
            <TabContainer Name="TabContainer" VerticalExpand="True">
                <BoxContainer Orientation="Vertical">
                    <ScrollContainer VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="6">
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <ui:HighlightedContainer HorizontalExpand="True">
                                    <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                                        <BoxContainer HorizontalExpand="True" SeparationOverride="6">
                                            <Label Text="{Loc 'humanoid-profile-editor-species-label'}" MinWidth="136" VerticalAlignment="Center" />
                                            <Control HorizontalExpand="True" />
                                            <TextureButton Name="SpeciesInfoButton" Scale="0.3 0.3"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Loc 'humanoid-profile-editor-guidebook-button-tooltip'}"/>
                                            <OptionButton Name="SpeciesButton" MinWidth="150" HorizontalAlignment="Right" />
                                        </BoxContainer>
                                        <BoxContainer HorizontalExpand="True" SeparationOverride="6">
                                            <Label Text="{Loc 'humanoid-profile-editor-age-label'}" MinWidth="136" VerticalAlignment="Center" />
                                            <Control HorizontalExpand="True" />
                                            <LineEdit Name="AgeEdit" MinSize="64 0" HorizontalAlignment="Right" />
                                        </BoxContainer>
                                        <BoxContainer HorizontalExpand="True" SeparationOverride="6">
                                            <Label Text="{Loc 'humanoid-profile-editor-sex-label'}" MinWidth="136" VerticalAlignment="Center" />
                                            <Control HorizontalExpand="True" />
                                            <OptionButton Name="SexButton" MinWidth="150" HorizontalAlignment="Right" />
                                        </BoxContainer>
                                        <BoxContainer HorizontalExpand="True" SeparationOverride="6">
                                            <Label Text="{Loc 'humanoid-profile-editor-pronouns-label'}" MinWidth="136" VerticalAlignment="Center" />
                                            <Control HorizontalExpand="True" />
                                            <OptionButton Name="PronounsButton" MinWidth="150" HorizontalAlignment="Right" />
                                        </BoxContainer>
                                        <BoxContainer HorizontalExpand="True" SeparationOverride="6">
                                            <Label Text="{Loc 'humanoid-profile-editor-clothing'}" MinWidth="136" VerticalAlignment="Center" />
                                            <Control HorizontalExpand="True" />
                                            <Button Name="ShowClothes" Pressed="True" ToggleMode="True" Text="{Loc 'humanoid-profile-editor-clothing-show'}" MinWidth="150" HorizontalAlignment="Right" />
                                        </BoxContainer>
                                        <BoxContainer HorizontalExpand="True" SeparationOverride="6">
                                            <Label Text="{Loc 'humanoid-profile-editor-spawn-priority-label'}" MinWidth="136" VerticalAlignment="Center" />
                                            <Control HorizontalExpand="True" />
                                            <OptionButton Name="SpawnPriorityButton" MinWidth="150" HorizontalAlignment="Right" />
                                        </BoxContainer>
                                        <BoxContainer HorizontalExpand="True" Visible="False" Name="TTSContainer" SeparationOverride="6">
                                            <Label Text="{Loc 'humanoid-profile-editor-voice-label'}" MinWidth="136" VerticalAlignment="Center" />
                                            <Control HorizontalExpand="True" />
                                            <OptionButton Name="VoiceButton" MinWidth="150" HorizontalAlignment="Right" />
                                            <Button Name="VoicePlayButton" Text="{Loc 'humanoid-profile-editor-voice-play'}" MinWidth="72" />
                                        </BoxContainer>
                                    </BoxContainer>
                                </ui:HighlightedContainer>

                                <ui:HighlightedContainer MinWidth="420">
                                    <BoxContainer Orientation="Vertical" SeparationOverride="6" HorizontalExpand="True">
                                        <BoxContainer HorizontalExpand="True" Orientation="Vertical" SeparationOverride="4">
                                            <Label Text="{Loc 'humanoid-profile-editor-skin-color-label'}" />
                                            <Slider HorizontalExpand="True" Name="Skin" MinValue="0" MaxValue="100" Value="20" />
                                            <BoxContainer Name="RgbSkinColorContainer" Visible="False" Orientation="Vertical" HorizontalExpand="True"></BoxContainer>
                                        </BoxContainer>
                                        <BoxContainer Orientation="Vertical" SeparationOverride="4">
                                            <Label Text="{Loc 'humanoid-profile-editor-eyes-label'}" />
                                            <humanoid:EyeColorPicker Name="EyeColorPicker" />
                                        </BoxContainer>
                                    </BoxContainer>
                                </ui:HighlightedContainer>
                            </BoxContainer>

                            <ui:HighlightedContainer>
                                <BoxContainer Orientation="Vertical" SeparationOverride="6" HorizontalExpand="True">
                                    <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
                                        <humanoid:SingleMarkingPicker Name="HairStylePicker" Category="Hair" HorizontalExpand="True" />
                                        <humanoid:SingleMarkingPicker Name="FacialHairPicker" Category="FacialHair" HorizontalExpand="True" />
                                    </BoxContainer>
                                </BoxContainer>
                            </ui:HighlightedContainer>

                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <ui:HighlightedContainer HorizontalExpand="True">
                                    <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                                        <Label Text="{Loc 'humanoid-profile-editor-hair-gradient-label'}" />
                                        <CheckBox Name="HairGradientToggle" Text="{Loc 'humanoid-profile-editor-hair-gradient-enable'}" />
                                        <ColorSelectorSliders Name="HairGradientSecondColorSelector" HorizontalExpand="True" />
                                        <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                                            <Label Text="{Loc 'humanoid-profile-editor-hair-gradient-direction'}" VerticalAlignment="Center" />
                                            <Control HorizontalExpand="True" />
                                            <OptionButton Name="HairGradientDirectionSelector" MinWidth="140" VerticalAlignment="Center" />
                                        </BoxContainer>
                                    </BoxContainer>
                                </ui:HighlightedContainer>

                                <ui:HighlightedContainer HorizontalExpand="True">
                                    <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                                        <Label Text="{Loc 'humanoid-profile-editor-facialhair-gradient-label'}" />
                                        <CheckBox Name="FacialHairGradientToggle" Text="{Loc 'humanoid-profile-editor-hair-gradient-enable'}" />
                                        <ColorSelectorSliders Name="FacialHairGradientSecondColorSelector" HorizontalExpand="True" />
                                        <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                                            <Label Text="{Loc 'humanoid-profile-editor-hair-gradient-direction'}" VerticalAlignment="Center" />
                                            <Control HorizontalExpand="True" />
                                            <OptionButton Name="FacialHairGradientDirectionSelector" MinWidth="140" VerticalAlignment="Center" />
                                        </BoxContainer>
                                    </BoxContainer>
                                </ui:HighlightedContainer>

                                <ui:HighlightedContainer HorizontalExpand="True">
                                    <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                                        <Label Text="{Loc 'humanoid-profile-editor-allmarkings-gradient-label'}" />
                                        <CheckBox Name="AllMarkingsGradientToggle" Text="{Loc 'humanoid-profile-editor-hair-gradient-enable'}" />
                                        <ColorSelectorSliders Name="AllMarkingsGradientSecondColorSelector" HorizontalExpand="True" />
                                        <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                                            <Label Text="{Loc 'humanoid-profile-editor-hair-gradient-direction'}" VerticalAlignment="Center" />
                                            <Control HorizontalExpand="True" />
                                            <OptionButton Name="AllMarkingsGradientDirectionSelector" MinWidth="140" VerticalAlignment="Center" />
                                        </BoxContainer>
                                    </BoxContainer>
                                </ui:HighlightedContainer>
                            </BoxContainer>
                        </BoxContainer>
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Orientation="Vertical">
                    <!-- Jobs -->
                    <OptionButton Name="PreferenceUnavailableButton" />
                    <ScrollContainer VerticalExpand="True">
                        <BoxContainer Name="JobList" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>
                <!-- Frontier: no Antags tab
                <BoxContainer Orientation="Vertical" Margin="10">
                    <! - - Antags  - - >
                    <ScrollContainer VerticalExpand="True">
                        <BoxContainer Name="AntagList" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>
                End Frontier -->
                <BoxContainer Orientation="Vertical" Margin="10">
                    <!-- Traits -->
                    <ScrollContainer VerticalExpand="True">
                        <BoxContainer Name="TraitsList" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Name="MarkingsTab" Orientation="Vertical" Margin="10">
                    <!-- Markings -->
                    <ScrollContainer VerticalExpand="True">
                        <humanoid:MarkingPicker Name="Markings" IgnoreCategories="Hair,FacialHair" />
                    </ScrollContainer>
                </BoxContainer>
            </TabContainer>
        </BoxContainer>
</BoxContainer>
