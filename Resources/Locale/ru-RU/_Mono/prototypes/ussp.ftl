# USSP (_Mono) entity localization

ent-BaseUSSPPDA = КПК СССП
    .desc = Базовый персональный компьютер для контроля доступа и организации, произведённый на предприятиях СССП.
    .suffix = СССП

ent-ClothingUniformUSSP = Полевая форма СССП
    .desc = Стандартная полевая форма Вооружённых Сил СССП.
    .suffix = СССП

ent-ClothingUniformServiceDressUSSP = Парадно-выходная форма СССП
    .desc = Более формальная форма для военнослужащих, стилизованная под униформу времён борьбы с ранним ТСФ.
    .suffix = СССП

ent-BookTheCommonCause = «Общее дело»
    .desc = Массовым тиражом выпущенный гражданский текст для всех граждан Союза. Короткие отрывки подчёркивают долг, труд, дисциплину и моральную ценность коллективной жизни.
    .suffix = СССП

ent-BookTheCommonCauseFirstEdition = «Общее дело»
    .desc = Раннее издание «Общего дела», приписываемое Автарху. Переплёт суров, бумага постарела, а слова куда менее сдержанны, чем в поздних гражданских изданиях.
    .suffix = Первое издание, СССП

ent-BookUSSPLaw = Устав полевых сил СССП
    .desc = Полевой устав, который носят все военнослужащие СССП. Любой сержант может процитировать его наизусть — обычно слишком громко для тесных помещений.
    .suffix = СССП

ent-ClothingHeadHatUSSPCommissarCap = Фуражка комиссара СССП
    .desc = Белая фуражка политических комиссаров СССП.
    .suffix = СССП

ent-ClothingHeadHatUSSPOfficerCap = Фуражка офицера СССП
    .desc = Зелёная фуражка офицеров СССП.
    .suffix = СССП

ent-ClothingHeadHelmetCombatUSSP = Полевой шлем СССП
    .desc = Стандартный полевой шлем СССП с компактной антенной решёткой — черта новых образцов, разработанных под требования ДСТ.
    .suffix = СССП

ent-ClothingHeadHelmetHardsuitOfficerCombat = USSP UF-16 "Voenkom" commissar tacsuit helmet
    .desc = Cold, imposing, and unmistakably Union -- developed to instill discipline and fear. It's visor grants enhanced battlefield awareness with It's built-in command control map. Ideal for Commissars overseeing frontline operations.
    .suffix = СССП

ent-ClothingHeadHelmetHardsuitUsspL10 = Шлем скафандра СССП L-10
    .desc = Старая модель боевого скафандра СССП, которая до сих пор используется на передовой.
    .suffix = СССП

ent-ClothingHeadHelmetHardsuitUsspL10A = Шлем скафандра СССП L-10-A
    .desc = Старая модель боевого скафандра СССП, которая до сих пор используется на передовой.
    .suffix = СССП

ent-ClothingHeadHelmetHardsuitUsspL27 = USSP L-27 tacsuit helmet
    .desc = The standard combat suit of USSP naval operations, outfitted with a medical hud too!
    .suffix = СССП

ent-ClothingHeadHelmetHardsuitUsspL30 = USSP L-30 Commissar parade hardsuit tactical helmet
    .desc = The commissar's parade hardsuit helmet, outfitted with a medical hud too to check on the troops!
    .suffix = СССП

ent-ClothingHeadHelmetHardsuitUsspM10 = USSP M-10 scoutsuit helmet
    .desc = A new prototype of combat suit using the old L-10 as a baseline. It has a integrated mass scanner in his helmet.
    .suffix = СССП

ent-ClothingHeadHelmetHeavyUSSP = Тяжёлый шлем СССП
    .desc = Тяжёлый баллистический шлем, обеспечивающий достойную защиту.
