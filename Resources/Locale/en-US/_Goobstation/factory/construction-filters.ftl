# Factory automation filter constructions
construction-recipe-label-filter = label filter
construction-recipe-label-filter-desc = A filter that can be installed in a robotic arm. This one scans labels of attached items.
construction-recipe-name-filter = name filter
construction-recipe-name-filter-desc = A filter that can be installed in a robotic arm. This one uses complex AI vision technology to identify items.
construction-recipe-stack-filter = stack filter
construction-recipe-stack-filter-desc = A filter that can be installed in a robotic arm. This one weighs items to compare it to a stack size.
construction-recipe-pressure-filter = pressure filter
construction-recipe-pressure-filter-desc = A filter that can be installed in factory machines. This one has a barometer to check the pressure of gases.
construction-recipe-combined-filter = combined filter
construction-recipe-combined-filter-desc = A filter that can be installed in a robotic arm. This one uses a logic gate to combine 2 installed item filters.
