light_mode unshaded;

uniform lowp vec4 tint_color;

void fragment() {
    lowp vec4 base = zTexture(UV);
    lowp float brightness = max(base.r, max(base.g, base.b));
    COLOR = vec4(tint_color.rgb * brightness, base.a * tint_color.a);
}
