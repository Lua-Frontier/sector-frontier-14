uniform highp float time;
uniform highp float pixels;
uniform highp float seed;
uniform highp float rotation;
uniform highp float time_speed;
uniform highp vec2 light_origin;
uniform highp float size;
uniform highp float octaves;
uniform highp float dither_size;
uniform highp float light_distance1;
uniform highp float light_distance2;
uniform highp vec3 color0;
uniform highp vec3 color1;
uniform highp vec3 color2;
uniform highp vec3 color3;
uniform highp vec3 color4;

// Shared PixelPlanets utils (inlined; SWSL has no #include)
highp float pp_mod1(highp float x, highp float y) {
    return x - y * floor(x / y);
}
highp vec2 pp_mod2(highp vec2 x, highp vec2 y) {
    return x - y * floor(x / y);
}
highp float pp_rand(highp float size, highp vec2 sizeMod, highp float seed, highp vec2 coord) {
    coord = pp_mod2(coord, sizeMod * round(size));
    return fract(sin(dot(coord.xy, vec2(12.9898, 78.233))) * 0.5453 * seed);
}
highp float pp_noise(highp float size, highp vec2 sizeMod, highp float seed, highp vec2 coord) {
    highp vec2 i = floor(coord);
    highp vec2 f = fract(coord);
    highp float a = pp_rand(size, sizeMod, seed, i);
    highp float b = pp_rand(size, sizeMod, seed, i + vec2(1.0, 0.0));
    highp float c = pp_rand(size, sizeMod, seed, i + vec2(0.0, 1.0));
    highp float d = pp_rand(size, sizeMod, seed, i + vec2(1.0, 1.0));
    highp vec2 cubic = f * f * (3.0 - 2.0 * f);
    return mix(a, b, cubic.x) + (c - a) * cubic.y * (1.0 - cubic.x) + (d - b) * cubic.x * cubic.y;
}
highp float pp_fbm(highp float size, highp vec2 sizeMod, highp float seed, highp float octaves, highp vec2 coord) {
    highp float value = 0.0;
    highp float scale = 0.5;
    for (int i = 0; i < 8; i++) {
        if (float(i) >= octaves)
            break;
        value += pp_noise(size, sizeMod, seed, coord) * scale;
        coord *= 2.0;
        scale *= 0.5;
    }
    return value;
}
highp float pp_circle_noise(highp float size, highp vec2 sizeMod, highp float seed, highp vec2 uv) {
    highp float uv_y = floor(uv.y);
    uv.x += uv_y * 0.31;
    highp vec2 f = fract(uv);
    highp float h = pp_rand(size, sizeMod, seed, vec2(floor(uv.x), floor(uv_y)));
    highp float m = length(f - 0.25 - (h * 0.5));
    highp float r = h * 0.25;
    return smoothstep(0.0, r, m * 0.75);
}
highp float pp_circle_noise_crater(highp float size, highp vec2 sizeMod, highp float seed, highp vec2 uv) {
    highp float uv_y = floor(uv.y);
    uv.x += uv_y * 0.31;
    highp vec2 f = fract(uv);
    highp float h = pp_rand(size, sizeMod, seed, vec2(floor(uv.x), floor(uv_y)));
    highp float m = length(f - 0.25 - (h * 0.5));
    highp float r = h * 0.25;
    return smoothstep(r - 0.10 * r, r, m);
}
highp float pp_crater(highp float size, highp vec2 sizeMod, highp float seed, highp float time, highp float time_speed, highp vec2 uv) {
    highp float c = 1.0;
    for (int i = 0; i < 2; i++) {
        c *= pp_circle_noise_crater(size, sizeMod, seed, (uv * size) + (float(i + 1) + 10.0) + vec2(time * time_speed, 0.0));
    }
    return 1.0 - c;
}
highp float pp_cloud_alpha(highp float size, highp vec2 sizeMod, highp float seed, highp float time, highp float time_speed, highp float octaves, highp vec2 uv) {
    highp float c_noise = 0.0;
    for (int i = 0; i < 9; i++) {
        c_noise += pp_circle_noise(size, sizeMod, seed, (uv * size * 0.3) + (float(i + 1) + 10.0) + vec2(time * time_speed, 0.0));
    }
    return pp_fbm(size, sizeMod, seed, octaves, uv * size + c_noise + vec2(time * time_speed, 0.0));
}
highp float pp_turbulence(highp float size, highp vec2 sizeMod, highp float seed, highp float time, highp float time_speed, highp vec2 uv) {
    highp float c_noise = 0.0;
    for (int i = 0; i < 10; i++) {
        c_noise += pp_circle_noise(size, sizeMod, seed, (uv * size * 0.3) + (float(i + 1) + 10.0) + vec2(time * time_speed, 0.0));
    }
    return c_noise;
}
bool pp_dither(highp float pixels, highp float dither_size, highp vec2 uv_pixel, highp vec2 uv_real) {
    return false;
}
highp vec2 pp_spherify(highp vec2 uv) {
    highp vec2 centered = uv * 2.0 - 1.0;
    highp float z = pow(max(1.0 - dot(centered.xy, centered.xy), 0.0), 0.5);
    highp vec2 sphere = centered / (z + 1.0);
    return sphere * 0.5 + 0.5;
}
highp vec2 pp_rotate(highp vec2 coord, highp float angle) {
    coord = coord - 0.5;
    highp float c = cos(angle);
    highp float s = sin(angle);
    coord = vec2(coord.x * c + coord.y * s, -coord.x * s + coord.y * c);
    return coord + 0.5;
}
highp vec2 pp_scale(highp vec2 coord, highp float scaleValue) {
    return coord * scaleValue - (scaleValue - 1.0) / 2.0;
}

void fragment() {
    highp vec2 inputUV = UV;
    highp vec2 uv = floor(inputUV * pixels) / pixels;
    // Circle on flat UV before spherify (post-spherify distance wrongly fills corners).
    highp float a = step(distance(uv, vec2(0.5, 0.5)), 0.49999);
    if (a < 0.5) {
        discard;
    }
    bool dith = pp_dither(pixels, dither_size, uv, inputUV);
    highp float d_light = distance(uv, light_origin);
    uv = pp_rotate(uv, rotation);
    uv = pp_spherify(uv);
    highp float f = pp_fbm(size, vec2(2.0, 1.0), seed, octaves, uv * size + vec2(time * time_speed, 0.0));
    d_light = smoothstep(-0.3, 1.2, d_light);
    if (d_light < light_distance1) {
        d_light *= 0.9;
    }
    if (d_light < light_distance2) {
        d_light *= 0.9;
    }
    highp float c = d_light * pow(abs(f), 0.8) * 3.5;
    if (dith) {
        c += 0.02;
        c *= 1.05;
    }
    highp float posterize = floor(c * 4.0) / 4.0;
    highp vec3 col = color4;
    if (posterize < 0.25) col = color0;
    else if (posterize < 0.40) col = color1;
    else if (posterize < 0.65) col = color2;
    else if (posterize < 0.80) col = color3;
    COLOR = vec4(col, a);
}
