light_mode unshaded;

uniform highp float time;
uniform highp float pixels;
uniform highp float pixels_ring;
uniform highp float seed;
uniform highp float rotation;
uniform highp float time_speed;
uniform highp float should_dither;
uniform highp float disk_width;
uniform highp float ring_perspective;
uniform highp float disk_size;
uniform highp float octaves;
uniform highp float hole_radius;
uniform highp float hole_light_width;
uniform highp vec3 hole_c0;
uniform highp vec3 hole_c1;
uniform highp vec3 hole_c2;
uniform highp vec3 ring_c0;
uniform highp vec3 ring_c1;
uniform highp vec3 ring_c2;
uniform highp vec3 ring_c3;
uniform highp vec3 ring_c4;

// Shared PixelPlanets utils (inlined; SWSL has no #include)
highp float pp_mod1(highp float x, highp float y) {
    return x - y * floor(x / y);
}
highp vec2 pp_mod2(highp vec2 x, highp vec2 y) {
    return x - y * floor(x / y);
}
highp float pp_rand(highp float size, highp vec2 sizeMod, highp float seed, highp vec2 coord) {
    coord = pp_mod2(coord, sizeMod * round(size));
    return fract(sin(dot(coord.xy, vec2(12.9898, 78.233))) * 0.5453 * seed);
}
highp float pp_noise(highp float size, highp vec2 sizeMod, highp float seed, highp vec2 coord) {
    highp vec2 i = floor(coord);
    highp vec2 f = fract(coord);
    highp float a = pp_rand(size, sizeMod, seed, i);
    highp float b = pp_rand(size, sizeMod, seed, i + vec2(1.0, 0.0));
    highp float c = pp_rand(size, sizeMod, seed, i + vec2(0.0, 1.0));
    highp float d = pp_rand(size, sizeMod, seed, i + vec2(1.0, 1.0));
    highp vec2 cubic = f * f * (3.0 - 2.0 * f);
    return mix(a, b, cubic.x) + (c - a) * cubic.y * (1.0 - cubic.x) + (d - b) * cubic.x * cubic.y;
}
highp float pp_fbm(highp float size, highp vec2 sizeMod, highp float seed, highp float octaves, highp vec2 coord) {
    highp float value = 0.0;
    highp float scale = 0.5;
    for (int i = 0; i < 8; i++) {
        if (float(i) >= octaves)
            break;
        value += pp_noise(size, sizeMod, seed, coord) * scale;
        coord *= 2.0;
        scale *= 0.5;
    }
    return value;
}
highp float pp_circle_noise(highp float size, highp vec2 sizeMod, highp float seed, highp vec2 uv) {
    highp float uv_y = floor(uv.y);
    uv.x += uv_y * 0.31;
    highp vec2 f = fract(uv);
    highp float h = pp_rand(size, sizeMod, seed, vec2(floor(uv.x), floor(uv_y)));
    highp float m = length(f - 0.25 - (h * 0.5));
    highp float r = h * 0.25;
    return smoothstep(0.0, r, m * 0.75);
}
highp float pp_circle_noise_crater(highp float size, highp vec2 sizeMod, highp float seed, highp vec2 uv) {
    highp float uv_y = floor(uv.y);
    uv.x += uv_y * 0.31;
    highp vec2 f = fract(uv);
    highp float h = pp_rand(size, sizeMod, seed, vec2(floor(uv.x), floor(uv_y)));
    highp float m = length(f - 0.25 - (h * 0.5));
    highp float r = h * 0.25;
    return smoothstep(r - 0.10 * r, r, m);
}
highp float pp_crater(highp float size, highp vec2 sizeMod, highp float seed, highp float time, highp float time_speed, highp vec2 uv) {
    highp float c = 1.0;
    for (int i = 0; i < 2; i++) {
        c *= pp_circle_noise_crater(size, sizeMod, seed, (uv * size) + (float(i + 1) + 10.0) + vec2(time * time_speed, 0.0));
    }
    return 1.0 - c;
}
highp float pp_cloud_alpha(highp float size, highp vec2 sizeMod, highp float seed, highp float time, highp float time_speed, highp float octaves, highp vec2 uv) {
    highp float c_noise = 0.0;
    for (int i = 0; i < 9; i++) {
        c_noise += pp_circle_noise(size, sizeMod, seed, (uv * size * 0.3) + (float(i + 1) + 10.0) + vec2(time * time_speed, 0.0));
    }
    return pp_fbm(size, sizeMod, seed, octaves, uv * size + c_noise + vec2(time * time_speed, 0.0));
}
highp float pp_turbulence(highp float size, highp vec2 sizeMod, highp float seed, highp float time, highp float time_speed, highp vec2 uv) {
    highp float c_noise = 0.0;
    for (int i = 0; i < 10; i++) {
        c_noise += pp_circle_noise(size, sizeMod, seed, (uv * size * 0.3) + (float(i + 1) + 10.0) + vec2(time * time_speed, 0.0));
    }
    return c_noise;
}
bool pp_dither(highp float pixels, highp float dither_size, highp vec2 uv_pixel, highp vec2 uv_real) {
    return false;
}
highp vec2 pp_spherify(highp vec2 uv) {
    highp vec2 centered = uv * 2.0 - 1.0;
    highp float z = pow(max(1.0 - dot(centered.xy, centered.xy), 0.0), 0.5);
    highp vec2 sphere = centered / (z + 1.0);
    return sphere * 0.5 + 0.5;
}
highp vec2 pp_rotate(highp vec2 coord, highp float angle) {
    coord = coord - 0.5;
    highp float c = cos(angle);
    highp float s = sin(angle);
    coord = vec2(coord.x * c + coord.y * s, -coord.x * s + coord.y * c);
    return coord + 0.5;
}
highp vec2 pp_scale(highp vec2 coord, highp float scaleValue) {
    return coord * scaleValue - (scaleValue - 1.0) / 2.0;
}

highp float ring_rand(highp vec2 coord, highp float sz, highp float sd) {
    coord = pp_mod2(coord, vec2(2.0, 1.0) * round(sz));
    return fract(sin(dot(coord.xy, vec2(12.9898, 78.233))) * 15.5453 * sd);
}
highp float ring_noise(highp vec2 coord, highp float sz, highp float sd) {
    highp vec2 i = floor(coord);
    highp vec2 f = fract(coord);
    highp float a = ring_rand(i, sz, sd);
    highp float b = ring_rand(i + vec2(1.0, 0.0), sz, sd);
    highp float c = ring_rand(i + vec2(0.0, 1.0), sz, sd);
    highp float d = ring_rand(i + vec2(1.0, 1.0), sz, sd);
    highp vec2 cubic = f * f * (3.0 - 2.0 * f);
    return mix(a, b, cubic.x) + (c - a) * cubic.y * (1.0 - cubic.x) + (d - b) * cubic.x * cubic.y;
}
highp float ring_fbm(highp vec2 coord, highp float sz, highp float sd, highp float oct) {
    highp float value = 0.0;
    highp float scale = 0.5;
    for (int i = 0; i < 8; i++) {
        if (float(i) >= oct)
            break;
        value += ring_noise(coord, sz, sd) * scale;
        coord *= 2.0;
        scale *= 0.5;
    }
    return value;
}
void fragment() {
    highp vec2 uv = UV;
    highp vec4 hole = vec4(0.0);
    if (uv.x > (1.0 / 3.0) && uv.x < (2.0 / 3.0) && uv.y > (1.0 / 3.0) && uv.y < (2.0 / 3.0)) {
        highp vec2 luv = (uv - (1.0 / 3.0)) * 3.0;
        highp vec2 puv = floor(luv * pixels) / pixels;
        highp float d_to_center = distance(puv, vec2(0.5, 0.5));
        highp vec3 col = hole_c0;
        if (d_to_center > hole_radius - hole_light_width)
            col = hole_c1;
        if (d_to_center > hole_radius - hole_light_width * 0.5)
            col = hole_c2;
        hole = vec4(col, step(d_to_center, hole_radius));
    }
    highp vec2 ruv = floor(uv * pixels_ring) / pixels_ring;
    bool dith = pp_dither(pixels_ring, 1.0, ruv, uv);
    ruv = pp_rotate(ruv, rotation);
    highp vec2 uv2 = ruv;
    ruv.x -= 0.5;
    ruv.x *= 1.3;
    ruv.x += 0.5;
    ruv = pp_rotate(ruv, sin(time * time_speed * 2.0) * 0.01);
    highp vec2 l_origin = vec2(0.5, 0.5);
    highp float d_width = disk_width;
    if (ruv.y < 0.5) {
        ruv.y += smoothstep(distance(vec2(0.5, 0.5), ruv), 0.5, 0.2);
        d_width += smoothstep(distance(vec2(0.5, 0.5), ruv), 0.5, 0.3);
        l_origin.y -= smoothstep(distance(vec2(0.5, 0.5), ruv), 0.5, 0.2);
    } else if (ruv.y > 0.53) {
        ruv.y -= smoothstep(distance(vec2(0.5, 0.5), ruv), 0.4, 0.17);
        d_width += smoothstep(distance(vec2(0.5, 0.5), ruv), 0.5, 0.2);
        l_origin.y += smoothstep(distance(vec2(0.5, 0.5), ruv), 0.5, 0.2);
    }
    highp float light_d = distance(uv2 * vec2(1.0, ring_perspective), l_origin * vec2(1.0, ring_perspective)) * 0.3;
    highp vec2 uv_center = ruv - vec2(0.0, 0.5);
    uv_center *= vec2(1.0, ring_perspective);
    highp float center_d = distance(uv_center, vec2(0.5, 0.0));
    highp float disk = smoothstep(0.1 - d_width * 2.0, 0.5 - d_width, center_d);
    disk *= smoothstep(center_d - d_width, center_d, 0.4);
    uv_center = pp_rotate(uv_center + vec2(0.0, 0.5), time * time_speed * 3.0);
    disk *= pow(ring_fbm(uv_center * disk_size, disk_size, seed, octaves), 0.5);
    if (dith || should_dither < 0.5) {
        disk *= 1.2;
    }
    highp float posterized = floor((disk + light_d) * 4.0);
    posterized = min(posterized, 4.0);
    highp vec3 rcol = ring_c4;
    if (posterized < 0.5) rcol = ring_c0;
    else if (posterized < 1.5) rcol = ring_c1;
    else if (posterized < 2.5) rcol = ring_c2;
    else if (posterized < 3.5) rcol = ring_c3;
    highp float disk_a = step(0.15, disk);
    highp vec4 ring = vec4(rcol, disk_a);
    highp float outA = ring.a + hole.a * (1.0 - ring.a);
    highp vec3 outRgb = ring.rgb * ring.a + hole.rgb * hole.a * (1.0 - ring.a);
    COLOR = vec4(outRgb, outA);
}
