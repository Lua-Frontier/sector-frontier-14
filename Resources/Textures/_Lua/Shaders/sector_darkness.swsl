uniform sampler2D SCREEN_TEXTURE;
uniform highp float strength;
uniform highp float darkness;
uniform highp float vignette;
uniform highp float contrast;
uniform highp float sharpness;

void fragment() {
    highp vec4 color = zTextureSpec(SCREEN_TEXTURE, UV);
    highp vec2 pixel = SCREEN_PIXEL_SIZE.xy;
    highp vec3 blur = (zTextureSpec(SCREEN_TEXTURE, UV + vec2(pixel.x, 0.0)).rgb
        + zTextureSpec(SCREEN_TEXTURE, UV - vec2(pixel.x, 0.0)).rgb
        + zTextureSpec(SCREEN_TEXTURE, UV + vec2(0.0, pixel.y)).rgb
        + zTextureSpec(SCREEN_TEXTURE, UV - vec2(0.0, pixel.y)).rgb) * 0.25;
    highp vec3 sharp = max(color.rgb + (color.rgb - blur) * sharpness, vec3(0.0));

    highp float edge = smoothstep(0.2, 0.75, length(UV - vec2(0.5))) * vignette;
    highp vec3 tone = pow(sharp, vec3(1.0 / 2.2));
    tone = clamp((tone - vec3(0.5)) * contrast + vec3(0.5), 0.0, 1.0);
    highp vec3 graded = pow(tone, vec3(2.2)) * (1.0 - darkness) * (1.0 - edge);

    COLOR = vec4(mix(color.rgb, graded, strength), color.a);
}
